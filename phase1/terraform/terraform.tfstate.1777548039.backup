            "arn": "arn:aws:iam::019167255542:policy/AmazonEKS_EBS_CSI_Policy-20260404014906778600000003",
            "attachment_count": 1,
            "description": "Provides permissions to manage EBS volumes via the container storage interface driver",
            "id": "arn:aws:iam::019167255542:policy/AmazonEKS_EBS_CSI_Policy-20260404014906778600000003",
