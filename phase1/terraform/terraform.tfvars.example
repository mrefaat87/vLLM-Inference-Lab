# terraform.tfvars.example — Copy to terraform.tfvars and fill in your values
# NEVER commit terraform.tfvars (it's in .gitignore) — it contains your IP and tokens.
#
# Usage:
#   cp terraform.tfvars.example terraform.tfvars
#   # Edit terraform.tfvars with your values
#   terraform plan

# Your region — us-east-1 has the best GPU spot availability
aws_region = "us-east-1"

# EKS cluster name — used everywhere as a discovery tag
cluster_name = "inference-lab"

# Kubernetes version — 1.29 is stable with Karpenter v0.33
cluster_version = "1.29"

# VPC CIDR — /16 gives plenty of IPs for VPC CNI pod networking
vpc_cidr = "10.0.0.0/16"

# AZs — two is enough for HA without tripling NAT Gateway costs
azs = ["us-east-1a", "us-east-1b"]

# CPU nodes — system workloads only (CoreDNS, Karpenter, API gateway)
cpu_instance_type = "t3.medium"
cpu_node_count    = 2

# REQUIRED: Your public IP for SSH access (find it: curl ifconfig.me)
# Format: "x.x.x.x/32" — the /32 restricts to exactly your IP
my_ip = "YOUR_IP_HERE/32"

# Optional: HuggingFace token for gated model downloads (Llama, Mistral, etc.)
# Get one at: https://huggingface.co/settings/tokens
hf_token = ""
