            "json": "{\n  \"Version\": \"2012-10-17\",\n  \"Statement\": [\n    {\n      \"Effect\": \"Allow\",\n      \"Action\": \"sts:AssumeRoleWithWebIdentity\",\n      \"Principal\": {\n        \"Federated\": \"arn:aws:iam::019167255542:oidc-provider/oidc.eks.us-east-1.amazonaws.com/id/A570F881B05A349630FEF0D1CDF3970C\"\n      },\n      \"Condition\": {\n        \"StringEquals\": {\n          \"oidc.eks.us-east-1.amazonaws.com/id/A570F881B05A349630FEF0D1CDF3970C:aud\": \"sts.amazonaws.com\",\n          \"oidc.eks.us-east-1.amazonaws.com/id/A570F881B05A349630FEF0D1CDF3970C:sub\": \"system:serviceaccount:kube-system:ebs-csi-controller-sa\"\n        }\n      }\n    }\n  ]\n}",
            "minified_json": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Action\":\"sts:AssumeRoleWithWebIdentity\",\"Principal\":{\"Federated\":\"arn:aws:iam::019167255542:oidc-provider/oidc.eks.us-east-1.amazonaws.com/id/A570F881B05A349630FEF0D1CDF3970C\"},\"Condition\":{\"StringEquals\":{\"oidc.eks.us-east-1.amazonaws.com/id/A570F881B05A349630FEF0D1CDF3970C:aud\":\"sts.amazonaws.com\",\"oidc.eks.us-east-1.amazonaws.com/id/A570F881B05A349630FEF0D1CDF3970C:sub\":\"system:serviceaccount:kube-system:ebs-csi-controller-sa\"}}}]}",
